---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: object;
  extraSchemas?: object[];
  speakable?: string[];
}

const { title, description, canonical, noindex = false, schema, extraSchemas = [], speakable = [] } = Astro.props;
const canonicalUrl = canonical || Astro.url.href;
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
const siteUrl = "https://usaconcretejobs.com";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "USA Concrete Jobs",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "telephone": "+18337223359",
  "description": "Licensed concrete cutting, waterproofing, and concrete finishing contractors serving Texas, Florida, California, Arizona, and Colorado.",
  "areaServed": [
    {"@type": "State", "name": "Texas"},
    {"@type": "State", "name": "Florida"},
    {"@type": "State", "name": "California"},
    {"@type": "State", "name": "Arizona"},
    {"@type": "State", "name": "Colorado"}
  ],
  "knowsAbout": ["Concrete cutting", "Waterproofing", "Concrete finishing", "Core drilling", "Flat sawing"],
  "sameAs": []
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "USA Concrete Jobs",
  "publisher": { "@id": `${siteUrl}/#organization` }
};

const speakableSchema = speakable.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "speakable": { "@type": "SpeakableSpecification", "cssSelector": speakable },
  "url": canonicalUrl
} : null;

const allSchemas = [orgSchema, websiteSchema, ...(schema ? [schema] : []), ...extraSchemas, ...(speakableSchema ? [speakableSchema] : [])];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="USA Concrete Jobs" />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  )}
  <meta name="author" content="USA Concrete Jobs" />
  <meta name="publisher" content="USA Concrete Jobs" />
  {allSchemas.map(s => (<script type="application/ld+json" set:html={JSON.stringify(s)} />))}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/styles/theme.css" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="logo-icon">🏗️</span>
        <span class="logo-text">USA Concrete Jobs</span>
      </a>
      <nav class="main-nav">
        <a href="/services/">Services</a>
        <a href="/states/">By State</a>
        <a href="/jobs/">Job Board</a>
        <a href="/cost/">Cost Guide</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
      </nav>
      <a href={phoneHref} class="btn btn-primary header-cta">📞 {phone}</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu">☰</button>
    </div>
  </header>

  <nav class="mobile-nav" id="mobileNav">
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">×</button>
    <a href="/services/">Services</a>
    <a href="/states/">By State</a>
    <a href="/jobs/">Job Board</a>
    <a href="/cost/">Cost Guide</a>
    <a href="/blog/">Blog</a>
    <a href="/faq/">FAQ</a>
    <a href="/contact/">Contact</a>
    <a href={phoneHref} style="color:#4ade80;font-weight:700;margin-top:16px;">📞 {phone}</a>
  </nav>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-col">
        <h3>USA Concrete Jobs</h3>
        <p>Licensed concrete cutting, waterproofing, and concrete finishing contractors serving Texas, Florida, California, Arizona, and Colorado.</p>
        <a href={phoneHref} class="footer-phone">{phone}</a>
        <p class="footer-license">Licensed · Insured · 5 States</p>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="/services/concrete-cutting/">Concrete Cutting</a></li>
          <li><a href="/services/waterproofing/">Waterproofing</a></li>
          <li><a href="/services/concrete-finishing/">Concrete Finishing</a></li>
          <li><a href="/services/core-drilling/">Core Drilling</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>States</h4>
        <ul>
          <li><a href="/states/texas/">Texas</a></li>
          <li><a href="/states/florida/">Florida</a></li>
          <li><a href="/states/california/">California</a></li>
          <li><a href="/states/arizona/">Arizona</a></li>
          <li><a href="/states/colorado/">Colorado</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Resources</h4>
        <ul>
          <li><a href="/jobs/">Job Board</a></li>
          <li><a href="/jobs/post/">Post a Job</a></li>
          <li><a href="/contractors/">For Contractors</a></li>
          <li><a href="/cost/">Cost Guide</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact Us</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>© {new Date().getFullYear()} USA Concrete Jobs. All rights reserved.</p>
        <p class="disclaimer">This site connects property owners with licensed concrete contractors. Pricing estimates are for informational purposes only.</p>
      </div>
    </div>
  </footer>

  <div class="sticky-cta" id="stickyCta">
    <a href={phoneHref} class="btn btn-primary btn-full">📞 Call Now — Free Estimate</a>
  </div>

  <script>
    const menuToggle = document.getElementById('menuToggle');
    const mobileNav = document.getElementById('mobileNav');
    const mobileNavClose = document.getElementById('mobileNavClose');
    if (menuToggle && mobileNav) {
      menuToggle.addEventListener('click', () => mobileNav.classList.add('open'));
      mobileNavClose.addEventListener('click', () => mobileNav.classList.remove('open'));
      mobileNav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileNav.classList.remove('open')));
    }
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling;
        const isOpen = answer.classList.contains('open');
        document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
        document.querySelectorAll('.faq-question').forEach(b => b.classList.remove('open'));
        if (!isOpen) { answer.classList.add('open'); btn.classList.add('open'); }
      });
    });
  </script>
</body>
</html>
