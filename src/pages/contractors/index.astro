---
import Base from '../../layouts/Base.astro';
import { services, states } from '../../data/states.js';
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
---

<Base
  title="Join as a Concrete Contractor — Get Leads & Job Bids | USA Concrete Jobs"
  description="Licensed concrete contractors: join USA Concrete Jobs to receive pay-per-call leads and bid on posted jobs in your service area. TX, FL, CA, AZ, CO."
  canonical="https://usaconcretejobs.com/contractors/"
>

  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-badge">🔧 For Contractors</div>
        <h1>Grow Your Concrete Business with USA Concrete Jobs</h1>
        <p class="hero-subtitle">
          Two ways to get more work: receive pay-per-call leads from customers searching for your services, or bid on posted jobs in your service area. Only pay for results.
        </p>
        <div class="hero-cta-group">
          <a href="#join-form" class="btn btn-primary btn-lg">Join as a Contractor</a>
          <a href={phoneHref} class="btn btn-outline btn-lg" style="color:#fff; border-color:rgba(255,255,255,0.5);">📞 Call {phone}</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item"><span class="check">✓</span> Pay-Per-Call Leads</div>
          <div class="trust-item"><span class="check">✓</span> Job Board Bidding</div>
          <div class="trust-item"><span class="check">✓</span> Only Pay for Results</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Two Ways to Get Work</h2>
      </div>
      <div class="grid-2" style="gap:32px;">
        <div class="card">
          <h3>📞 Pay-Per-Call Leads</h3>
          <p>Customers call our number and are connected directly to you. You only pay for qualified calls from customers in your service area who are ready to hire.</p>
          <ul style="margin-top:12px; padding-left:20px; font-size:0.9rem;">
            <li style="margin-bottom:6px;">$20–$50 per qualified call</li>
            <li style="margin-bottom:6px;">Set your service area by zip code or city</li>
            <li style="margin-bottom:6px;">Control your monthly call volume and budget</li>
            <li>Pause or adjust anytime</li>
          </ul>
        </div>
        <div class="card">
          <h3>🏗️ Job Board Bidding</h3>
          <p>Browse posted jobs in your area and submit competitive bids. Customers compare bids and choose their contractor. You pay a small fee only when you win.</p>
          <ul style="margin-top:12px; padding-left:20px; font-size:0.9rem;">
            <li style="margin-bottom:6px;">Browse all jobs in your area</li>
            <li style="margin-bottom:6px;">Bid on jobs that match your specialty</li>
            <li style="margin-bottom:6px;">$25–$75 flat fee on jobs under $15K</li>
            <li>3–5% fee on larger jobs</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Contractor Fee Structure</h2>
        <p>Only pay when you get results. No monthly subscription, no hidden fees.</p>
      </div>
      <div class="grid-2" style="gap:48px;">
        <div>
          <h3>Pay-Per-Call Rates</h3>
          <table class="cost-table">
            <thead><tr><th>Call Type</th><th>Rate</th></tr></thead>
            <tbody>
              <tr><td>Standard qualified lead call</td><td class="cost-highlight">$20–$35</td></tr>
              <tr><td>Commercial job lead call</td><td class="cost-highlight">$35–$50</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <h3>Job Board Win Fees</h3>
          <table class="cost-table">
            <thead><tr><th>Job Value</th><th>Platform Fee</th></tr></thead>
            <tbody>
              <tr><td>Under $2,000</td><td class="cost-highlight">$25 flat</td></tr>
              <tr><td>$2,000 – $5,000</td><td class="cost-highlight">$50 flat</td></tr>
              <tr><td>$5,000 – $15,000</td><td class="cost-highlight">$75 flat</td></tr>
              <tr><td>Over $15,000</td><td class="cost-highlight">3–5% of job value</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="join-form">
    <div class="container">
      <div class="grid-2" style="gap:48px; align-items:start;">
        <div>
          <h2>Join as a Contractor</h2>
          <p>Fill out the form and we'll reach out within 1 business day to verify your license and set up your account.</p>
          <form class="lead-form" id="contractorForm" novalidate>

            <div class="form-group">
              <label for="biz-name">Business Name *</label>
              <input type="text" id="biz-name" name="business_name" placeholder="Acme Concrete LLC" required />
            </div>

            <div class="form-group">
              <label for="owner-name">Owner Name *</label>
              <input type="text" id="owner-name" name="owner_name" placeholder="John Smith" required />
            </div>

            <div class="form-group">
              <label for="cont-phone">Phone *</label>
              <input type="tel" id="cont-phone" name="phone" placeholder="(555) 000-0000" required />
            </div>

            <div class="form-group">
              <label for="cont-email">Email *</label>
              <input type="email" id="cont-email" name="email" placeholder="john@acmeconcrete.com" required />
            </div>

            <div class="form-group">
              <label for="cont-state">State of Operation *</label>
              <select id="cont-state" name="state" required>
                <option value="">Select state...</option>
                {states.map(s => (
                  <option value={s.abbr}>{s.name} ({s.abbr})</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="license-num">State License Number *</label>
              <input type="text" id="license-num" name="license_number" placeholder="e.g. TX-12345" required />
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
              <label for="cont-services">Services Offered (select all that apply) *</label>
              <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
                {services.map(service => (
                  <label style="display:flex; align-items:center; gap:6px; font-size:0.9rem; font-weight:normal; cursor:pointer;">
                    <input type="checkbox" name="services" value={service.slug} />
                    {service.name}
                  </label>
                ))}
              </div>
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
              <label for="service-area">Service Area (cities / counties) *</label>
              <textarea
                id="service-area"
                name="service_area"
                placeholder="e.g. Dallas, Fort Worth, Plano, and all of Dallas County"
                rows="3"
                required
              ></textarea>
            </div>

            <div style="grid-column: 1 / -1;">
              <button type="submit" class="btn btn-primary btn-full btn-lg">
                Apply to Join — Free
              </button>
              <div id="contractorMsg" style="display:none; margin-top:16px; padding:16px; border-radius:8px; text-align:center; font-weight:600;"></div>
            </div>
          </form>
          <script>
            document.getElementById('contractorForm')?.addEventListener('submit', async (e) => {
              e.preventDefault();
              const form = e.target as HTMLFormElement;
              const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
              const msg = document.getElementById('contractorMsg') as HTMLElement;
              btn.disabled = true;
              btn.textContent = 'Submitting…';
              const formData = new FormData(form);
              const services = formData.getAll('services');
              const data = { ...Object.fromEntries(formData), services };
              try {
                const res = await fetch('/api/contractors', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                if (res.ok) {
                  form.reset();
                  msg.style.display = 'block';
                  msg.style.background = '#d1fae5';
                  msg.style.color = '#065f46';
                  msg.textContent = '✓ Application received! We\'ll review your license and reach out within 1 business day.';
                } else {
                  throw new Error();
                }
              } catch {
                msg.style.display = 'block';
                msg.style.background = '#fee2e2';
                msg.style.color = '#991b1b';
                msg.textContent = 'Something went wrong. Please call us at (833) 722-3359.';
                btn.disabled = false;
                btn.textContent = 'Apply to Join — Free';
              }
            });
          </script>
        </div>

        <div>
          <div class="card" style="border: 2px solid var(--color-accent); margin-bottom:24px;">
            <h3 style="color:var(--color-accent);">Why Join USA Concrete Jobs?</h3>
            <ul style="margin-top:12px; padding-left:20px;">
              <li style="margin-bottom:8px;">High-intent leads — customers are actively searching and ready to hire</li>
              <li style="margin-bottom:8px;">Pay only for results — no subscription, no setup fee</li>
              <li style="margin-bottom:8px;">Control your volume — set your budget and service area</li>
              <li style="margin-bottom:8px;">500+ cities covered — TX, FL, CA, AZ, CO</li>
              <li>Bid on posted jobs in your exact service area</li>
            </ul>
          </div>

          <div class="card">
            <h3>Requirements</h3>
            <ul style="margin-top:12px; padding-left:20px; font-size:0.9rem;">
              <li style="margin-bottom:6px;">Active state contractor's license (concrete or relevant classification)</li>
              <li style="margin-bottom:6px;">General liability insurance ($1M minimum)</li>
              <li style="margin-bottom:6px;">Workers' compensation insurance</li>
              <li style="margin-bottom:6px;">3+ years in business preferred</li>
              <li>Service area in TX, FL, CA, AZ, or CO</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Questions About Joining?</h2>
      <p>Call us to learn more about the program and get started today.</p>
      <a href={phoneHref} class="cta-phone">{phone}</a>
      <p class="cta-subtext">Mon–Sat, 7am–6pm</p>
    </div>
  </section>

</Base>
