---
import Base from '../../layouts/Base.astro';
import { states, services } from '../../data/states.js';
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
const totalCounties = states.reduce((sum, s) => sum + s.counties.length, 0);
const totalCities = states.reduce((sum, s) => sum + s.counties.reduce((cs, c) => cs + c.cities.length, 0), 0);
---

<Base
  title="About USA Concrete Jobs — Licensed Nationwide"
  description="USA Concrete Jobs connects homeowners with licensed, insured concrete contractors for cutting, waterproofing, finishing & more across 5 states. Free estimates."
  canonical="https://usaconcretejobs.com/about/"
>

  <div class="page-hero">
    <div class="container">
      <h1>About USA Concrete Jobs</h1>
      <p>Connecting property owners with licensed concrete contractors across {states.length} states, {totalCounties} counties, and {totalCities}+ cities.</p>
    </div>
  </div>

  <section class="section">
    <div class="container content-section">

      <h2>What We Do</h2>
      <p>USA Concrete Jobs is a two-sided concrete services marketplace. We connect homeowners and businesses with vetted, licensed concrete contractors across Texas, Florida, California, Arizona, and Colorado.</p>
      <p>Whether you need concrete cut, a driveway replaced, a foundation repaired, or a pool deck resurfaced, we match you with a licensed local contractor — fast, free, and with no obligation.</p>

      <h2>Two Ways to Connect</h2>
      <div class="grid-2" style="gap:32px; margin-top:24px;">
        <div class="card">
          <h3>📞 Call for Immediate Help</h3>
          <p>Call <a href={phoneHref}>{phone}</a> to speak directly with a vetted local concrete contractor. High intent, fast connection, no wait.</p>
          <a href={phoneHref} class="btn btn-primary btn-sm" style="margin-top:12px;">Call Now — Free Estimate</a>
        </div>
        <div class="card">
          <h3>🏗️ Post a Job & Get Bids</h3>
          <p>Describe your project, set your timeline and budget, and receive competitive bids from multiple verified contractors in your area.</p>
          <a href="/jobs/post/" class="btn btn-outline btn-sm" style="margin-top:12px;">Post a Job</a>
        </div>
      </div>

      <h2 style="margin-top:48px;">Our Standards</h2>
      <ul>
        <li>All contractors are licensed in their state of operation</li>
        <li>All contractors carry general liability and workers' compensation insurance</li>
        <li>All assessments and estimates are free with no obligation</li>
        <li>All contractors are verified against state licensing databases</li>
        <li>Permit assistance provided on every project that requires it</li>
      </ul>

      <h2>Services We Cover</h2>
      <div class="services-grid" style="margin-top:24px;">
        {services.map(service => (
          <a href={`/services/${service.slug}/`} class="service-card">
            <h3>{service.name}</h3>
            <p style="font-size:0.9rem;">{service.description}</p>
            <div class="service-cost">Typical: <strong>{service.avgCost}</strong></div>
          </a>
        ))}
      </div>

      <h2 style="margin-top:48px;">Coverage Area</h2>
      <table class="cost-table">
        <thead>
          <tr><th>State</th><th>License Authority</th><th>Counties</th><th>Cities</th></tr>
        </thead>
        <tbody>
          {states.map(state => (
            <tr>
              <td><strong>{state.name}</strong></td>
              <td><a href={state.licenseUrl} target="_blank" rel="noopener">{state.licenseAuthority}</a></td>
              <td>{state.counties.length}</td>
              <td>{state.counties.reduce((sum, c) => sum + c.cities.length, 0)}+</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div style="margin-top: 40px; text-align:center;">
        <a href={phoneHref} class="btn btn-primary btn-lg">📞 Call {phone} — Free Estimate</a>
      </div>

    </div>
  </section>

</Base>
