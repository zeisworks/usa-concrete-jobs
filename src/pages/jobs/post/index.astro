---
import Base from '../../../layouts/Base.astro';
import { services, states } from '../../../data/states.js';
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
---

<Base
  title="Post a Concrete Job — Get Bids from Licensed Contractors | USA Concrete Jobs"
  description="Post your concrete project and receive competitive bids from licensed, insured contractors in your area. Free to post. No obligation."
  canonical="https://usaconcretejobs.com/jobs/post/"
>

  <div class="page-hero">
    <div class="container">
      <h1>Post a Concrete Job</h1>
      <p>Describe your project and receive bids from licensed, insured concrete contractors in your area. Free to post, no obligation.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:48px; align-items:start;">

        <div>
          <h2>Describe Your Project</h2>
          <form class="lead-form" id="jobPostForm" novalidate>

            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" placeholder="Jane Smith" required />
            </div>

            <div class="form-group">
              <label for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" placeholder="(555) 000-0000" required />
            </div>

            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" placeholder="jane@email.com" required />
            </div>

            <div class="form-group">
              <label for="service">Service Needed *</label>
              <select id="service" name="service" required>
                <option value="">Select a service...</option>
                {services.map(service => (
                  <option value={service.slug}>{service.name}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="state">State *</label>
              <select id="state" name="state" required>
                <option value="">Select a state...</option>
                {states.map(state => (
                  <option value={state.abbr}>{state.name} ({state.abbr})</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="city">City *</label>
              <input type="text" id="city" name="city" placeholder="e.g. Austin, TX" required />
            </div>

            <div class="form-group">
              <label for="budget">Estimated Budget</label>
              <select id="budget" name="budget">
                <option value="">Not sure yet</option>
                <option value="under-2000">Under $2,000</option>
                <option value="2000-5000">$2,000 – $5,000</option>
                <option value="5000-15000">$5,000 – $15,000</option>
                <option value="over-15000">Over $15,000</option>
              </select>
            </div>

            <div class="form-group">
              <label for="timeline">Timeline</label>
              <select id="timeline" name="timeline">
                <option value="">Flexible</option>
                <option value="asap">As soon as possible</option>
                <option value="1-2-weeks">Within 1–2 weeks</option>
                <option value="1-month">Within 1 month</option>
                <option value="3-months">Within 3 months</option>
                <option value="planning">Just planning / getting prices</option>
              </select>
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
              <label for="description">Project Description *</label>
              <textarea
                id="description"
                name="description"
                placeholder="Describe your project: dimensions, current condition, what you need done, any special requirements..."
                rows="5"
                required
              ></textarea>
            </div>

            <div style="grid-column: 1 / -1;">
              <button type="submit" class="btn btn-primary btn-full btn-lg">
                Post My Job — Free
              </button>
              <p style="font-size:0.8rem; color:var(--color-text-muted); margin-top:8px; text-align:center;">
                By submitting you agree to our <a href="/terms/">Terms of Service</a> and <a href="/privacy/">Privacy Policy</a>.
              </p>
              <div id="jobMsg" style="display:none; margin-top:16px; padding:16px; border-radius:8px; text-align:center; font-weight:600;"></div>
            </div>
          </form>
          <script>
            document.getElementById('jobPostForm')?.addEventListener('submit', async (e) => {
              e.preventDefault();
              const form = e.target;
              const btn = form.querySelector('button[type="submit"]');
              const msg = document.getElementById('jobMsg');
              btn.disabled = true;
              btn.textContent = 'Submitting…';
              const data = Object.fromEntries(new FormData(form));
              try {
                const res = await fetch('/api/jobs', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                if (res.ok) {
                  form.reset();
                  msg.style.display = 'block';
                  msg.style.background = '#d1fae5';
                  msg.style.color = '#065f46';
                  msg.textContent = '✓ Job posted! Licensed contractors in your area will be in touch within 24–48 hours.';
                } else {
                  throw new Error();
                }
              } catch {
                msg.style.display = 'block';
                msg.style.background = '#fee2e2';
                msg.style.color = '#991b1b';
                msg.textContent = 'Something went wrong. Please call us at (833) 722-3359.';
                btn.disabled = false;
                btn.textContent = 'Post My Job — Free';
              }
            });
          </script>
        </div>

        <div>
          <div class="card" style="margin-bottom:24px;">
            <h3>What Happens Next</h3>
            <ol style="padding-left:20px; margin-top:12px;">
              <li style="margin-bottom:10px;">Your job is posted to licensed contractors in your area</li>
              <li style="margin-bottom:10px;">Contractors review your project and submit bids within 24–48 hours</li>
              <li style="margin-bottom:10px;">You receive bids by phone and email — compare and choose</li>
              <li style="margin-bottom:10px;">Hire the contractor you want. They pay a small platform fee when awarded</li>
              <li>Get your project done by a licensed, insured professional</li>
            </ol>
          </div>

          <div class="card" style="border: 2px solid var(--color-accent);">
            <h3 style="color:var(--color-accent);">Need an Answer Right Now?</h3>
            <p>Call to speak directly with a vetted local contractor — no waiting for bids.</p>
            <a href={phoneHref} class="btn btn-primary btn-full btn-lg" style="margin-top:12px;">📞 {phone}</a>
            <p style="font-size:0.8rem; color:var(--color-text-muted); margin-top:8px; text-align:center;">Mon–Sat, 7am–6pm</p>
          </div>

          <div class="card" style="margin-top:24px;">
            <h3>Platform Fee Structure</h3>
            <p style="font-size:0.85rem; color:var(--color-text-muted); margin-bottom:12px;">Customers post free. Contractors pay only when they win.</p>
            <table class="cost-table" style="font-size:0.85rem;">
              <thead><tr><th>Job Value</th><th>Contractor Fee</th></tr></thead>
              <tbody>
                <tr><td>Under $2,000</td><td>$25 flat</td></tr>
                <tr><td>$2,000–$5,000</td><td>$50 flat</td></tr>
                <tr><td>$5,000–$15,000</td><td>$75 flat</td></tr>
                <tr><td>Over $15,000</td><td>3–5%</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </section>

</Base>
