---
import Base from '../../layouts/Base.astro';
import { states, services } from '../../data/states.js';

export async function getStaticPaths() {
  const paths = [];
  for (const service of services) {
    for (const state of states) {
      paths.push({
        params: { service: service.slug, state: state.slug },
        props: { service, state }
      });
    }
  }
  return paths;
}

const { service, state } = Astro.props;
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
const pageUrl = `https://usaconcretejobs.com/${service.slug}/${state.slug}/`;
const totalCities = state.counties.reduce((sum, c) => sum + c.cities.length, 0);
---

<Base
  title={`${service.name} in ${state.name} | USA Concrete Jobs`}
  description={`Licensed ${service.name.toLowerCase()} contractors in ${state.name}. Serving ${state.counties.length} counties and ${totalCities}+ cities. ${state.avgCuttingCost !== undefined ? '' : ''}Free estimates. Call ${phone}.`}
  canonical={pageUrl}
>

  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/services/">Services</a>
      <span>›</span>
      <span>{service.name} in {state.name}</span>
    </nav>
  </div>

  <section class="hero hero-compact">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-badge">🔧 {state.name}</div>
        <h1>{service.name} in {state.name}</h1>
        <p class="hero-subtitle">
          Licensed, insured {service.name.toLowerCase()} contractors serving {state.counties.length} counties and {totalCities}+ cities across {state.name}. Free estimates, permit assistance.
        </p>
        <div class="hero-cta-group">
          <a href={phoneHref} class="btn btn-primary btn-lg">📞 Call {phone}</a>
          <a href="/jobs/post/" class="btn btn-outline btn-lg" style="color:#fff; border-color:rgba(255,255,255,0.5);">Post a Job &amp; Get Bids</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item"><span class="check">✓</span> Licensed & Insured</div>
          <div class="trust-item"><span class="check">✓</span> Free Estimates</div>
          <div class="trust-item"><span class="check">✓</span> {totalCities}+ Cities</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap: 48px; align-items: start;">
        <div>
          <h2>{service.name} Contractors in {state.name}</h2>
          <p>{state.climateNote}</p>
          <p>USA Concrete Jobs connects homeowners and businesses across {state.name} with licensed, insured {service.name.toLowerCase()} contractors. All contractors are verified through the <a href={state.licenseUrl} target="_blank" rel="noopener">{state.licenseAuthority}</a>.</p>

          <h3 style="margin-top: 24px;">Typical Cost in {state.name}</h3>
          <table class="cost-table" style="margin-top: 12px;">
            <thead><tr><th>Service</th><th>Typical Cost</th></tr></thead>
            <tbody>
              <tr><td>{service.name}</td><td class="cost-highlight">{service.avgCost}</td></tr>
            </tbody>
          </table>

          <h3 style="margin-top: 24px;">Permit Requirements — {state.name}</h3>
          <p>{state.permitNote}</p>
          <p style="margin-top:8px;">{service.permitNote}</p>
        </div>
        <div>
          <div class="card" style="border: 2px solid var(--color-accent); position: sticky; top: 100px;">
            <h3 style="color: var(--color-accent);">Free Estimate in {state.name}</h3>
            <p style="font-size:0.9rem; margin-bottom:8px;">Licensed · Insured · All {state.name} counties</p>
            <a href={phoneHref} class="btn btn-primary btn-full btn-lg" style="margin-bottom:12px;">📞 {phone}</a>
            <a href="/jobs/post/" class="btn btn-outline btn-full">Post a Job &amp; Get Bids</a>
            <hr style="margin: 16px 0; border-color: var(--color-border);" />
            <p style="font-size:0.85rem; color:var(--color-text-muted);">
              Licensed by: <a href={state.licenseUrl} target="_blank" rel="noopener">{state.licenseAuthority}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Counties We Serve in {state.name}</h2>
        <p>Select your county for local pricing, contractor availability, and city listings.</p>
      </div>
      <div class="grid-3">
        {state.counties.map(county => (
          <a href={`/${service.slug}/${state.slug}/${county.slug}/`} class="county-card">
            <h3>{county.name}</h3>
            <p style="font-size:0.85rem; color:var(--color-text-muted);">
              {county.cities.slice(0, 4).join(', ')}{county.cities.length > 4 ? ' & more' : ''}
            </p>
            <div style="margin-top:8px; font-size:0.8rem; color:var(--color-accent); font-weight:600;">
              {county.cities.length} cities →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Get Free {service.name} Estimates in {state.name}</h2>
      <p>Licensed contractors. Free estimates. Serving all {state.counties.length} counties in {state.name}.</p>
      <a href={phoneHref} class="cta-phone">{phone}</a>
      <p class="cta-subtext">Available Mon–Sat, 7am–6pm</p>
    </div>
  </section>

</Base>
