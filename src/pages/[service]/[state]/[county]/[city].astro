---
import { slugify } from '../../../../lib/slugify';
import Base from '../../../../layouts/Base.astro';
import { states, services } from '../../../../data/states.js';

export async function getStaticPaths() {
  const paths = [];
  for (const service of services) {
    for (const state of states) {
      for (const county of state.counties) {
        for (const city of county.cities) {
          const citySlug = slugify(city);
          paths.push({
            params: { service: service.slug, state: state.slug, county: county.slug, city: citySlug },
            props: { service, state, county, city, citySlug }
          });
        }
      }
    }
  }
  return paths;
}

const { service, state, county, city, citySlug } = Astro.props;
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";

const pageUrl = `https://usaconcretejobs.com/${service.slug}/${state.slug}/${county.slug}/${citySlug}/`;

const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": `USA Concrete Jobs — ${service.name} in ${city}, ${state.abbr}`,
  "description": `Licensed ${service.name.toLowerCase()} contractors in ${city}, ${county.name}, ${state.name}. Free estimates. Call ${phone}.`,
  "telephone": "+18337223359",
  "url": pageUrl,
  "serviceType": service.name,
  "areaServed": {
    "@type": "City",
    "name": city,
    "containedIn": {
      "@type": "AdministrativeArea",
      "name": county.name,
      "containedIn": { "@type": "State", "name": state.name }
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How much does ${service.name.toLowerCase()} cost in ${city}, ${state.abbr}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${service.name} in ${city} typically costs ${service.avgCost}. The exact price depends on project size, site conditions, materials, and accessibility. Most projects in ${county.name} require a free on-site assessment for an accurate quote. Call ${phone} for a free estimate.`
      }
    },
    {
      "@type": "Question",
      "name": `Do I need a permit for ${service.name.toLowerCase()} in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${service.permitNote} In ${city}, requirements can vary from the state standard — our licensed contractors can advise on local permit requirements and handle the paperwork on your behalf.`
      }
    },
    {
      "@type": "Question",
      "name": `How do I find a licensed ${service.name.toLowerCase()} contractor in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `USA Concrete Jobs connects you with licensed, insured ${service.name.toLowerCase()} contractors in ${city} and throughout ${county.name}. All contractors are verified through ${state.licenseAuthority}. Call ${phone} or use our free estimate form to be matched with a vetted local contractor.`
      }
    },
    {
      "@type": "Question",
      "name": `How quickly can I get a ${service.name.toLowerCase()} estimate in ${city}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Free on-site estimates in ${city} are typically available within 3–5 business days. During peak season, scheduling ahead is recommended. Call ${phone} to check current availability in ${county.name}.`
      }
    }
  ]
};

const otherServices = services.filter(s => s.slug !== service.slug);
---

<Base
  title={`${service.name} in ${city}, ${state.name} | USA Concrete Jobs`}
  description={`Licensed ${service.name.toLowerCase()} contractors in ${city}, ${county.name}, ${state.name}. Free estimates, insured work, permit assistance. Call ${phone}.`}
  canonical={pageUrl}
  schema={schema}
  extraSchemas={[faqSchema]}
>

  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/services/">Services</a>
      <span>›</span>
      <a href={`/${service.slug}/${state.slug}/`}>{service.name} in {state.name}</a>
      <span>›</span>
      <a href={`/${service.slug}/${state.slug}/${county.slug}/`}>{county.name}</a>
      <span>›</span>
      <span>{city}</span>
    </nav>
  </div>

  <section class="hero hero-compact">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-badge">🔧 {city}, {state.abbr}</div>
        <h1>{service.name} in {city}, {state.name}</h1>
        <p class="hero-subtitle">
          Licensed {service.name.toLowerCase()} contractors serving {city} and {county.name}. Free estimates, insured work, permit assistance.
        </p>
        <div class="hero-cta-group">
          <a href={phoneHref} class="btn btn-primary btn-lg">📞 Call {phone}</a>
          <a href="/jobs/post/" class="btn btn-outline btn-lg" style="color:#fff; border-color:rgba(255,255,255,0.5);">Post a Job &amp; Get Bids</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item"><span class="check">✓</span> Licensed & Insured</div>
          <div class="trust-item"><span class="check">✓</span> Free Estimates</div>
          <div class="trust-item"><span class="check">✓</span> Permit Assistance</div>
          <div class="trust-item"><span class="check">✓</span> Verified Contractors</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap: 48px; align-items: start;">
        <div>
          <h2>{service.name} in {city}, {state.name}</h2>
          <p>{state.climateNote}</p>
          <p>Our licensed contractors serve {city} and all communities in {county.name} with professional {service.name.toLowerCase()} services. Every project includes a free written estimate and permit assistance where required.</p>

          <h3 style="margin-top: 28px;">What's Included</h3>
          <ul style="margin: 16px 0; padding-left: 20px;">
            {service.keyFacts.map(fact => (
              <li style="margin-bottom: 8px;">{fact}</li>
            ))}
          </ul>

          <h3 style="margin-top: 28px;">Typical Cost in {city}, {state.abbr}</h3>
          <table class="cost-table" style="margin-top: 16px;">
            <thead>
              <tr><th>Service</th><th>Typical Cost</th></tr>
            </thead>
            <tbody>
              <tr><td>{service.name}</td><td class="cost-highlight">{service.avgCost}</td></tr>
            </tbody>
          </table>
          <p style="font-size:0.85rem; color: var(--color-text-muted); margin-top:8px;">
            Costs vary by project size, scope, and site conditions. Free on-site estimates available in {city}.
          </p>

          <div style="margin-top: 28px;">
            <h3>Licensing in {state.name}</h3>
            <p>All contractors are verified through the <a href={state.licenseUrl} target="_blank" rel="noopener">{state.licenseAuthority}</a>. {state.permitNote}</p>
          </div>
        </div>

        <div>
          <div class="card" style="border: 2px solid var(--color-accent); position: sticky; top: 100px;">
            <h3 style="color: var(--color-accent);">Free {service.name} Estimate in {city}</h3>
            <p style="font-size:0.95rem; margin-bottom: 8px;">Licensed contractors · Insured work · Permit assistance</p>
            <a href={phoneHref} class="btn btn-primary btn-full btn-lg" style="margin-bottom: 12px;">📞 {phone}</a>
            <a href="/jobs/post/" class="btn btn-outline btn-full">Post a Job &amp; Get Bids</a>
            <hr style="margin: 16px 0; border-color: var(--color-border);" />
            <h4 style="font-size:0.9rem; margin-bottom:8px;">Other Cities in {county.name}</h4>
            <div style="display:flex; flex-wrap:wrap; gap:6px;">
              {county.cities.filter(c => c !== city).slice(0, 6).map(c => {
                const cs = slugify(c);
                return <a href={`/${service.slug}/${state.slug}/${county.slug}/${cs}/`} style="font-size:0.8rem; color: var(--color-primary); text-decoration:underline;">{c}</a>;
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Other Concrete Services in {city}</h2>
        <p>Licensed contractors for all concrete services in {city} and {county.name}.</p>
      </div>
      <div class="services-grid">
        {otherServices.slice(0, 3).map(s => (
          <a href={`/${s.slug}/${state.slug}/${county.slug}/${citySlug}/`} class="service-card">
            <h3>{s.name}</h3>
            <p>{s.description}</p>
            <div class="service-cost">Typical Cost: <strong>{s.avgCost}</strong></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Frequently Asked Questions — {service.name} in {city}</h2>
      </div>
      <div class="faq-list">
        {faqSchema.mainEntity.map(item => (
          <div class="faq-item">
            <h3 class="faq-question">{item.name}</h3>
            <p class="faq-answer">{item.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Get Your Free {service.name} Estimate in {city}</h2>
      <p>Licensed contractors. Free estimates. Serving {city} and all of {county.name}.</p>
      <a href={phoneHref} class="cta-phone">{phone}</a>
      <p class="cta-subtext">Or <a href="/jobs/post/" style="color:rgba(255,255,255,0.85); text-decoration:underline;">post a job to get multiple bids</a> · Available Mon–Sat, 7am–6pm</p>
    </div>
  </section>

</Base>
