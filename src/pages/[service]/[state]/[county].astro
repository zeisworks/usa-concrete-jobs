---
import { slugify } from '../../../lib/slugify';
import Base from '../../../layouts/Base.astro';
import { states, services } from '../../../data/states.js';

export async function getStaticPaths() {
  const paths = [];
  for (const service of services) {
    for (const state of states) {
      for (const county of state.counties) {
        paths.push({
          params: { service: service.slug, state: state.slug, county: county.slug },
          props: { service, state, county }
        });
      }
    }
  }
  return paths;
}

const { service, state, county } = Astro.props;
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
const pageUrl = `https://usaconcretejobs.com/${service.slug}/${state.slug}/${county.slug}/`;
---

<Base
  title={`${service.name} in ${county.name}, ${state.name} | USA Concrete Jobs`}
  description={`Licensed ${service.name.toLowerCase()} contractors in ${county.name}, ${state.name}. Serving ${county.cities.slice(0, 4).join(', ')}, and more. Free estimates. Call ${phone}.`}
  canonical={pageUrl}
>

  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/services/">Services</a>
      <span>›</span>
      <a href={`/${service.slug}/${state.slug}/`}>{service.name} in {state.name}</a>
      <span>›</span>
      <span>{county.name}</span>
    </nav>
  </div>

  <section class="hero hero-compact">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-badge">🔧 {county.name}, {state.abbr}</div>
        <h1>{service.name} in {county.name}, {state.name}</h1>
        <p class="hero-subtitle">
          Licensed {service.name.toLowerCase()} contractors serving all cities and towns in {county.name}. Free estimates, insured work, permit assistance.
        </p>
        <div class="hero-cta-group">
          <a href={phoneHref} class="btn btn-primary btn-lg">📞 Call {phone}</a>
          <a href="/jobs/post/" class="btn btn-outline btn-lg" style="color:#fff; border-color:rgba(255,255,255,0.5);">Post a Job &amp; Get Bids</a>
        </div>
        <div class="hero-trust">
          <div class="trust-item"><span class="check">✓</span> Licensed & Insured</div>
          <div class="trust-item"><span class="check">✓</span> Free Estimates</div>
          <div class="trust-item"><span class="check">✓</span> Permit Assistance</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap: 48px; align-items: start;">
        <div>
          <h2>{service.name} Contractors in {county.name}</h2>
          <p>{state.climateNote}</p>
          <p>USA Concrete Jobs connects homeowners and businesses in {county.name} with licensed, insured {service.name.toLowerCase()} contractors. Every project includes a free written estimate and permit assistance.</p>

          <h3 style="margin-top: 24px;">Typical Cost — {county.name}</h3>
          <table class="cost-table" style="margin-top: 12px;">
            <thead><tr><th>Service</th><th>Typical Cost</th></tr></thead>
            <tbody>
              <tr><td>{service.name}</td><td class="cost-highlight">{service.avgCost}</td></tr>
            </tbody>
          </table>

          <h3 style="margin-top: 24px;">What's Included</h3>
          <ul style="margin: 12px 0; padding-left: 20px;">
            {service.keyFacts.map(fact => (
              <li style="margin-bottom: 6px;">{fact}</li>
            ))}
          </ul>
        </div>
        <div>
          <div class="card" style="border: 2px solid var(--color-accent); position: sticky; top: 100px;">
            <h3 style="color: var(--color-accent);">Free Estimate — {county.name}</h3>
            <p style="font-size:0.9rem; margin-bottom:8px;">Licensed · Insured · Permit assistance</p>
            <a href={phoneHref} class="btn btn-primary btn-full btn-lg" style="margin-bottom:12px;">📞 {phone}</a>
            <a href="/jobs/post/" class="btn btn-outline btn-full">Post a Job &amp; Get Bids</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Cities We Serve in {county.name}</h2>
        <p>Select your city for local pricing, contractor availability, and permit information.</p>
      </div>
      <div class="town-grid">
        {county.cities.map(c => {
          const cs = slugify(c);
          return (
            <a href={`/${service.slug}/${state.slug}/${county.slug}/${cs}/`} class="town-link">
              {c}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Get Free {service.name} Estimates in {county.name}</h2>
      <p>Licensed contractors. Free estimates. Serving all of {county.name}, {state.name}.</p>
      <a href={phoneHref} class="cta-phone">{phone}</a>
      <p class="cta-subtext">Available Mon–Sat, 7am–6pm</p>
    </div>
  </section>

</Base>
