---
import Base from '../../layouts/Base.astro';
import { states } from '../../data/states.js';
import { services } from '../../data/states.js';

export async function getStaticPaths() {
  return services.map(service => ({
    params: { service: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
---

<Base
  title={`${service.name} — 5 States | USA Concrete Jobs`}
  description={`${service.description} Serving Texas, Florida, California, Arizona, and Colorado. Free estimates. Call ${phone}.`}
  canonical={`https://usaconcretejobs.com/services/${service.slug}/`}
>

  <section class="page-hero">
    <div class="container">
      <div class="hero-badge">🔧 Concrete Service</div>
      <h1>{service.name}</h1>
      <p class="hero-subtitle">{service.description}</p>
      <div class="hero-cta-group">
        <a href={phoneHref} class="btn btn-primary btn-lg">📞 Call {phone}</a>
        <a href="/#get-estimate" class="btn btn-outline btn-lg">Get Free Estimate</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:48px; align-items:start;">
        <div>
          <h2>About {service.name}</h2>
          <p>{service.description}</p>
          <h3 style="margin-top:24px;">Typical Cost</h3>
          <p style="font-size:1.5rem; font-weight:700; color:var(--color-accent);">{service.avgCost}</p>
          <h3 style="margin-top:24px;">Key Facts</h3>
          <ul style="list-style:none; padding:0;">
            {service.keyFacts.map(fact => (
              <li style="display:flex; gap:10px; margin-bottom:14px; padding:12px; background:#f8f9fa; border-radius:6px;">
                <span style="color:var(--color-success); font-weight:700; flex-shrink:0;">✓</span>
                <span>{fact}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <div class="card" style="border: 2px solid var(--color-accent);">
            <h3 style="color: var(--color-accent);">Get a Free Quote</h3>
            <p style="font-size:0.95rem; margin-bottom: 8px;">Licensed contractors · Insured work · Free estimates</p>
            <a href={phoneHref} class="btn btn-primary btn-full btn-lg" style="margin-bottom: 12px;">📞 {phone}</a>
            <a href="/#get-estimate" class="btn btn-outline btn-full">Request Free Estimate</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Find {service.name} Contractors by State</h2>
      </div>
      <div class="county-grid">
        {states.map(state => (
          <a href={`/${service.slug}/${state.slug}/`} class="county-card">
            <h3>{state.name}</h3>
            <p>{state.counties.length} metro areas · Cutting from {state.avgCuttingCost.split('–')[0]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Get a Free {service.name} Estimate</h2>
      <p>Licensed contractors in 5 states. Free estimates. Insured work.</p>
      <a href={phoneHref} class="cta-phone">{phone}</a>
    </div>
  </section>

</Base>
