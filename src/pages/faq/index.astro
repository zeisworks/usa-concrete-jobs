---
import Base from '../../layouts/Base.astro';
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";

const faqs = [
  { q: "How much does concrete cutting cost?", a: "Residential projects typically range from $500–$3,000. Commercial projects vary widely. We provide free quotes for all project types." },
  { q: "What types of concrete cutting do you offer?", a: "We connect you with contractors who offer flat sawing, wall sawing, core drilling, wire sawing, and concrete removal." },
  { q: "Do you serve my area?", a: "We serve Texas, Florida, California, Arizona, and Colorado, covering major metro areas and surrounding communities." },
  { q: "How do I get a quote?", a: `Call us at ${phone} or fill out our contact form. We'll connect you with a licensed contractor for a free quote.` },
  { q: "Are the contractors licensed and insured?", a: "Yes. We only connect you with licensed, insured contractors." },
  { q: "What's the difference between concrete cutting and demolition?", a: "Concrete cutting is precise removal of specific sections. Demolition is full removal of structures. Most contractors offer both." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
};
---
<Base
  title="Frequently Asked Questions | USA Concrete Jobs"
  description="Get answers to common questions about concrete cutting, waterproofing, and finishing services."
  canonical="https://usaconcretejobs.com/faq/"
  extraSchemas={[faqSchema]}
>
  <section class="section">
    <div class="container" style="max-width:800px;">
      <div class="section-header">
        <h1>Frequently Asked Questions</h1>
        <p>Can't find what you're looking for? Call us at {phone}.</p>
      </div>
      <div class="faq-list" style="margin-top:32px;">
        {faqs.map(({ q, a }) => (
          <div class="faq-item">
            <div class="faq-question">{q}</div>
            <div class="faq-answer">{a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="cta-section">
    <div class="container">
      <h2>Still Have Questions?</h2>
      <a href={phoneHref} class="cta-phone">{phone}</a>
    </div>
  </section>
</Base>
