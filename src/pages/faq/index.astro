---
import Base from '../layouts/Base.astro';
const phone = "(833) 722-3359";
const phoneHref = "tel:+183****3359";
---
<Base
  title="Frequently Asked Questions | USA Concrete Jobs"
  description="Get answers to common questions about concrete cutting, waterproofing, and finishing services."
  canonical="https://usaconcretejobs.com/faq/"
>
  <section class="section">
    <div class="container" style="max-width:800px;">
      <div class="section-header">
        <h1>Frequently Asked Questions</h1>
        <p>Can't find what you're looking for? Call us at {phone}.</p>
      </div>
      <div class="faq-list" style="margin-top:32px;">
        <div class="faq-item">
          <div class="faq-question">How much does concrete cutting cost?</div>
          <div class="faq-answer">Residential projects typically range from $500–$3,000. Commercial projects vary widely. We provide free quotes for all project types.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">What types of concrete cutting do you offer?</div>
          <div class="faq-answer">We connect you with contractors who offer flat sawing, wall sawing, core drilling, wire sawing, and concrete removal.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">Do you serve my area?</div>
          <div class="faq-answer">We serve Texas, Florida, California, Arizona, and Colorado, covering major metro areas and surrounding communities.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">How do I get a quote?</div>
          <div class="faq-answer">Call us at (833) 722-3359 or fill out our contact form. We'll connect you with a licensed contractor for a free quote.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">Are the contractors licensed and insured?</div>
          <div class="faq-answer">Yes. We only connect you with licensed, insured contractors.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">What's the difference between concrete cutting and demolition?</div>
          <div class="faq-answer">Concrete cutting is precise removal of specific sections. Demolition is full removal of structures. Most contractors offer both.</div>
        </div>
      </div>
    </div>
  </section>
  <section class="cta-section">
    <div class="container">
      <h2>Still Have Questions?</h2>
      <a href="{phoneHref}" class="cta-phone">{phone}</a>
    </div>
  </section>
</Base>