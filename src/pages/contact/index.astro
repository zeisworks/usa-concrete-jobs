---
import Base from '../../layouts/Base.astro';
const phone = "(833) 722-3359";
const phoneHref = "tel:+18337223359";
---
<Base
  title="Contact Us | USA Concrete Jobs — Get a Free Quote"
  description="Contact USA Concrete Jobs for a free quote. Call (833) 722-3359 or fill out our form."
  canonical="https://usaconcretejobs.com/contact/"
>
  <section class="section">
    <div class="container" style="max-width:800px;">
      <div class="section-header">
        <h1>Contact Us</h1>
        <p>Get in touch for a free, no-obligation quote.</p>
      </div>
      <div class="grid-2" style="gap:48px; align-items:start;">
        <div>
          <h2>Get Your Free Quote</h2>
          <form class="lead-form" style="margin-top:24px;">
            <div class="form-group">
              <label for="name">Full Name *</label>
              <input type="text" id="name" name="name" required placeholder="Jane Smith" />
            </div>
            <div class="form-group">
              <label for="phone_input">Phone Number *</label>
              <input type="tel" id="phone_input" name="phone" required placeholder="(555) 000-0000" />
            </div>
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" required placeholder="jane@email.com" />
            </div>
            <div class="form-group">
              <label for="zip">ZIP Code *</label>
              <input type="text" id="zip" name="zip" required placeholder="90210" />
            </div>
            <div class="form-group form-group-full">
              <label for="message">Tell Us About Your Project</label>
              <textarea id="message" name="message" rows="4" placeholder="Describe what you need help with..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">Get My Free Quote →</button>
            <p style="font-size:0.85rem;color:var(--color-text-muted);text-align:center;margin-top:12px;">No spam. Response within 24 hours.</p>
            <div id="contactMsg" style="display:none; margin-top:16px; padding:16px; border-radius:8px; text-align:center; font-weight:600;"></div>
          </form>
          <script is:inline>
            document.querySelector('.lead-form')?.addEventListener('submit', async (e) => {
              e.preventDefault();
              const form = e.target;
              const btn = form.querySelector('button[type="submit"]');
              const msg = document.getElementById('contactMsg');
              btn.disabled = true;
              btn.textContent = 'Submitting…';
              const data = Object.fromEntries(new FormData(form));
              try {
                const res = await fetch('https://ucj-api.jack-be1.workers.dev/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                if (res.ok) {
                  form.reset();
                  msg.style.display = 'block';
                  msg.style.background = '#d1fae5';
                  msg.style.color = '#065f46';
                  msg.textContent = '✓ Thanks! We\'ll be in touch within 24 hours.';
                } else {
                  throw new Error();
                }
              } catch {
                msg.style.display = 'block';
                msg.style.background = '#fee2e2';
                msg.style.color = '#991b1b';
                msg.textContent = 'Something went wrong. Please call us at (833) 722-3359.';
                btn.disabled = false;
                btn.textContent = 'Get My Free Quote →';
              }
            });
          </script>
        </div>
        <div>
          <h2>Other Ways to Reach Us</h2>
          <div class="card" style="margin-top:16px;">
            <h3>📞 Call Us</h3>
            <p><a href="tel:+18337223359" style="font-size:1.4rem;font-weight:700;">(833) 722-3359</a></p>
            <p style="font-size:0.9rem;color:var(--color-text-muted);">Mon–Sat, 7am–6pm</p>
          </div>
          <div class="card" style="margin-top:16px;">
            <h3>📧 Email Us</h3>
            <p><a href="mailto:info@usaconcretejobs.com">info@usaconcretejobs.com</a></p>
          </div>
          <div class="card" style="margin-top:16px;">
            <h3>📍 Service Areas</h3>
            <p>Texas, Florida, California, Arizona, Colorado</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Get Started?</h2>
      <a href="tel:+18337223359" class="cta-phone">(833) 722-3359</a>
    </div>
  </section>
</Base>