---
import Base from '../../layouts/Base.astro';
import { states } from '../../data/states.js';
const phone = "(833) 722-3359";
const phoneHref = "tel:+183****3359";
const siteUrl = "https://usaconcretejobs.com";
---

<Base
  title="Concrete Contractors by State | USA Concrete Jobs"
  description="Find licensed concrete contractors serving Texas, Florida, California, Arizona, and Colorado. Concrete cutting, waterproofing, foundation repair, and more."
  canonical={`${siteUrl}/states/`}
>
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-badge">🏗️ By State</div>
        <h1>Concrete Contractors by State</h1>
        <p class="hero-subtitle">
          Licensed, insured concrete contractors serving 5 states. Find local experts for concrete cutting, waterproofing, foundation repair, and more.
        </p>
        <div class="hero-trust">
          <div class="trust-item"><span class="check">✓</span> Texas</div>
          <div class="trust-item"><span class="check">✓</span> Florida</div>
          <div class="trust-item"><span class="check">✓</span> California</div>
          <div class="trust-item"><span class="check">✓</span> Arizona</div>
          <div class="trust-item"><span class="check">✓</span> Colorado</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Select Your State</h2>
        <p>Choose a state to browse counties and cities with available concrete contractors.</p>
      </div>
      <div class="grid-3" style="gap:24px;">
        {states.map(state => (
          <a href={`/states/${state.slug}/`} class="card" style="text-decoration:none;">
            <h3>{state.name}</h3>
            <p style="font-size:0.85rem; color:var(--color-text-muted);">
              {state.counties.length} counties · {state.counties.reduce((s, c) => s + c.cities.length, 0)}+ cities
            </p>
            <p style="font-size:0.85rem; margin-top:8px;">{state.climateNote.substring(0, 100)}...</p>
            <span class="btn btn-primary btn-sm" style="margin-top:12px;">View {state.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Ready to Get Started?</h2>
      <p>Call us to speak directly with a vetted local contractor.</p>
      <a href={phoneHref} class="cta-phone">{phone}</a>
      <p class="cta-subtext">Mon–Sat, 7am–6pm</p>
    </div>
  </section>
</Base>
