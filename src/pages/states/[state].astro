---
import Base from '../../layouts/Base.astro';
import { states, services } from '../../data/states.js';

export async function getStaticPaths() {
  return states.map(state => ({
    params: { state: state.slug },
    props: { state }
  }));
}

const { state } = Astro.props;
const phone = "(855) 288-7767";
const phoneHref = "tel:+18552887767";
const totalCities = state.counties.reduce((sum, c) => sum + c.cities.length, 0);

const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": `Concrete Cutting Pros — ${state.name}`,
  "description": `Licensed concrete cutting, waterproofing, and concrete finishing contractors in ${state.name}. Serving ${state.counties.length} metro areas. Free estimates.`,
  "telephone": "+18552887767",
  "areaServed": { "@type": "State", "name": state.name }
};
---

<Base
  title={`Concrete Cutting, Waterproofing & Finishing in ${state.name} | Concrete Cutting Pros`}
  description={`Find licensed concrete cutting, waterproofing, and concrete finishing contractors in ${state.name}. Serving ${totalCities}+ cities. Free estimates. Call ${phone}.`}
  canonical={`https://concretecuttingpros.com/states/${state.slug}/`}
  schema={schema}
>

  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-badge">🔧 {state.name} Concrete Contractors</div>
        <h1>Concrete Cutting, Waterproofing & Finishing in {state.name}</h1>
        <p class="hero-subtitle">
          {state.climateNote}
        </p>
        <div class="hero-cta-group">
          <a href={phoneHref} class="btn btn-primary btn-lg">📞 Call {phone}</a>
          <a href="/#get-estimate" class="btn btn-outline btn-lg">Get Free Estimate</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:48px; align-items:start;">
        <div>
          <h2>{state.name} Concrete Services Overview</h2>
          <table class="cost-table">
            <tbody>
              <tr><td><strong>License Authority</strong></td><td><a href={state.licenseUrl} target="_blank" rel="noopener">{state.licenseAuthority}</a></td></tr>
              <tr><td><strong>Concrete Cutting Cost</strong></td><td class="cost-highlight">{state.avgCuttingCost}</td></tr>
              <tr><td><strong>Waterproofing Cost</strong></td><td class="cost-highlight">{state.avgWaterproofingCost}</td></tr>
              <tr><td><strong>Metro Areas Served</strong></td><td>{state.counties.length}</td></tr>
              <tr><td><strong>Cities Covered</strong></td><td>{totalCities}+</td></tr>
              <tr><td><strong>Permit Requirements</strong></td><td>{state.permitNote}</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <div class="card" style="border: 2px solid var(--color-accent);">
            <h3 style="color: var(--color-accent);">Free Estimate in {state.name}</h3>
            <p style="font-size:0.95rem; margin-bottom: 8px;">Licensed contractors · Insured work · Permit assistance</p>
            <a href={phoneHref} class="btn btn-primary btn-full btn-lg" style="margin-bottom: 12px;">📞 {phone}</a>
            <a href="/#get-estimate" class="btn btn-outline btn-full">Request Free Estimate</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Metro Areas We Serve in {state.name}</h2>
        <p>Select your metro area to find local contractors and city-specific information.</p>
      </div>
      <div class="county-grid">
        {state.counties.map(county => (
          <a href={`/states/${state.slug}/${county.slug}/`} class="county-card">
            <h3>{county.name}</h3>
            <p>{county.cities.length} cities · Free estimates</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Services Available in {state.name}</h2>
      </div>
      <div class="services-grid">
        {services.map(service => (
          <div class="service-card">
            <h3>{service.name}</h3>
            <p>{service.description}</p>
            <div class="service-cost">Typical Cost: <strong>{service.avgCost}</strong></div>
            <a href={phoneHref} class="btn btn-primary btn-sm">📞 Call for Free Quote</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Get Your Free {state.name} Concrete Estimate</h2>
      <p>Licensed contractors. Free estimates. Serving all of {state.name}.</p>
      <a href={phoneHref} class="cta-phone">{phone}</a>
    </div>
  </section>

</Base>
