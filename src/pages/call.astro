---
// Pay-per-call optimized landing page — branded to match site
import Base from '../layouts/Base.astro';
import { services } from '../data/states.js';
const phone = "(833) 722-3359";
const phoneHref = "tel:+183****3359";
---

<Base
  title={`Call Now — Licensed Concrete Contractors | ${phone} | USA Concrete Jobs`}
  description="Call now to connect with licensed, insured concrete contractors in your area. Free estimates for concrete cutting, waterproofing, finishing, and more."
  canonical="https://usaconcretejobs.com/call/"
  noindex={true}
>
  <style>
    .ppc-hero {
      background: linear-gradient(135deg, var(--color-primary-dark) 0%, #0d2818 50%, var(--color-primary) 100%);
      padding: 60px 0 48px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .ppc-hero::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(ellipse at center, rgba(22,163,74,0.15) 0%, transparent 70%);
      pointer-events: none;
    }
    .ppc-hero-inner { position: relative; z-index: 1; }
    .ppc-badge {
      display: inline-block;
      background: rgba(22,163,74,0.2);
      color: #4ade80;
      padding: 8px 20px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 24px;
      border: 1px solid rgba(22,163,74,0.3);
    }
    .ppc-hero h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 900;
      color: #fff;
      line-height: 1.15;
      margin-bottom: 16px;
    }
    .ppc-hero h1 span { color: #facc15; }
    .ppc-subtitle {
      font-size: 1.15rem;
      color: rgba(255,255,255,0.75);
      margin-bottom: 32px;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }
    .ppc-cta-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .ppc-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: #16a34a;
      color: #fff;
      font-size: 1.5rem;
      font-weight: 800;
      padding: 22px 52px;
      border-radius: 60px;
      text-decoration: none;
      transition: all 0.2s;
      box-shadow: 0 4px 24px rgba(22,163,74,0.4);
      animation: ppc-pulse 2s infinite;
    }
    .ppc-cta:hover {
      background: #22c55e;
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(22,163,74,0.5);
    }
    @keyframes ppc-pulse {
      0%, 100% { box-shadow: 0 4px 24px rgba(22,163,74,0.4); }
      50% { box-shadow: 0 4px 40px rgba(22,163,74,0.6); }
    }
    .ppc-phone { font-size: 1.7rem; letter-spacing: 1px; }
    .ppc-trust {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 28px;
      flex-wrap: wrap;
    }
    .ppc-trust-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.9rem;
      color: rgba(255,255,255,0.6);
    }
    .ppc-trust-item .check { color: #4ade80; font-weight: 700; }

    /* Callback form */
    .ppc-callback-section {
      padding: 48px 0;
      background: var(--color-bg-alt);
    }
    .ppc-callback-inner {
      max-width: 480px;
      margin: 0 auto;
      text-align: center;
    }
    .ppc-callback-inner h2 {
      font-size: 1.5rem;
      margin-bottom: 8px;
      color: var(--color-primary);
    }
    .ppc-callback-inner > p {
      color: var(--color-text-muted);
      margin-bottom: 24px;
    }
    .ppc-callback-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
      text-align: left;
    }
    .ppc-callback-form .form-row {
      display: flex;
      gap: 12px;
    }
    .ppc-callback-form .form-row input { flex: 1; }
    .ppc-callback-form input,
    .ppc-callback-form select,
    .ppc-callback-form textarea {
      padding: 14px 16px;
      font-size: 1rem;
      border: 2px solid var(--color-border);
      border-radius: 10px;
      width: 100%;
      box-sizing: border-box;
      font-family: inherit;
    }
    .ppc-callback-form input:focus,
    .ppc-callback-form select:focus,
    .ppc-callback-form textarea:focus {
      outline: none;
      border-color: #16a34a;
      box-shadow: 0 0 0 3px rgba(22,163,74,0.15);
    }
    .ppc-callback-form button {
      padding: 16px 32px;
      font-size: 1.15rem;
      font-weight: 700;
      background: #16a34a;
      color: #fff;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 4px;
    }
    .ppc-callback-form button:hover { background: #22c55e; transform: translateY(-1px); }
    .ppc-callback-form .form-note {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      text-align: center;
      margin-top: 8px;
    }
    @media (max-width: 480px) {
      .ppc-callback-form .form-row { flex-direction: column; }
    }

    /* Services strip */
    .ppc-services {
      padding: 40px 0;
      border-top: 1px solid var(--color-border);
    }
    .ppc-services h3 {
      text-align: center;
      font-size: 1rem;
      color: var(--color-text-muted);
      margin-bottom: 20px;
      font-weight: 500;
    }
    .ppc-services-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }
    .ppc-service-tag {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: 8px 18px;
      border-radius: 8px;
      font-size: 0.9rem;
      color: var(--color-text);
    }
    .ppc-service-tag .icon { margin-right: 6px; }

    /* States */
    .ppc-states {
      padding: 32px 0 48px;
      text-align: center;
      border-top: 1px solid var(--color-border);
    }
    .ppc-states h3 {
      font-size: 1rem;
      color: var(--color-text-muted);
      margin-bottom: 16px;
      font-weight: 500;
    }
    .ppc-states-list {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .ppc-state-badge {
      background: var(--color-primary);
      color: #fff;
      padding: 10px 24px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.95rem;
    }

    /* Urgency bar */
    .ppc-urgency {
      background: #f57c00;
      color: #fff;
      text-align: center;
      padding: 12px 20px;
      font-weight: 600;
      font-size: 0.95rem;
    }

    @media (max-width: 480px) {
      .ppc-cta { padding: 18px 36px; font-size: 1.2rem; }
      .ppc-phone { font-size: 1.4rem; }
      .ppc-trust { gap: 12px; }
      .ppc-zip-form { flex-direction: column; align-items: center; }
      .ppc-zip-form input[type="tel"] { width: 100%; max-width: 280px; }
    }
  </style>

  <!-- Urgency bar -->
  <div class="ppc-urgency">
    ⚡ High demand in your area — contractors are available now for immediate estimates
  </div>

  <!-- Hero -->
  <section class="ppc-hero">
    <div class="container ppc-hero-inner">
      <div class="ppc-badge">✓ Licensed & Insured Contractors — 5 States</div>
      <h1>Need Concrete Work?<br><span>Call Now for a Free Estimate.</span></h1>
      <p class="ppc-subtitle">
        We connect you with top-rated, licensed concrete contractors in your area. No obligation. No hassle. Just quality work at a fair price.
      </p>
      <div class="ppc-cta-wrap">
        <a href={phoneHref} class="ppc-cta" id="ppcMainCta">
          📞 <span class="ppc-phone">{phone}</span>
        </a>
      </div>
      <div class="ppc-trust">
        <div class="ppc-trust-item"><span class="check">✓</span> Free Estimates</div>
        <div class="ppc-trust-item"><span class="check">✓</span> Licensed & Insured</div>
        <div class="ppc-trust-item"><span class="check">✓</span> 456+ Cities</div>
        <div class="ppc-trust-item"><span class="check">✓</span> Same-Day Response</div>
      </div>
    </div>
  </section>

  <!-- Callback form → submits to Cloudflare Worker, then redirects to thanks -->
  <section class="ppc-callback-section">
    <div class="ppc-callback-inner">
      <h2>Or Request a Call Back</h2>
      <p>Give us your info and a licensed contractor will call you within 15 minutes.</p>
      <form class="ppc-callback-form" id="ppcCallbackForm" method="POST" action="/api/leads">
        <div class="form-row">
          <input type="text" name="name" placeholder="Your Name *" required autocomplete="name" />
          <input type="tel" name="phone" placeholder="Phone Number *" required autocomplete="tel" />
        </div>
        <div class="form-row">
          <input type="text" name="zip" placeholder="Zip Code *" maxlength="5" pattern="[0-9]{5}" required inputmode="numeric" autocomplete="postal-code" />
          <select name="service" required>
            <option value="" disabled selected>Service Needed *</option>
            {services.map(s => (
              <option value={s.slug}>{s.name}</option>
            ))}
          </select>
        </div>
        <textarea name="details" rows="2" placeholder="Brief project description (optional)"></textarea>
        <input type="hidden" name="source" value="ppc_call_page" />
        <button type="submit">Get My Free Call Back →</button>
        <p class="form-note">We'll only share your info with one licensed contractor in your area. No spam.</p>
      </form>
    </div>
  </section>

  <!-- Services strip -->
  <section class="ppc-services">
    <div class="container">
      <h3>Our Contractors Specialize In:</h3>
      <div class="ppc-services-grid">
        {services.map(s => (
          <span class="ppc-service-tag"><span class="icon">
            {s.slug === 'concrete-cutting' && '🔪'}
            {s.slug === 'waterproofing' && '💧'}
            {s.slug === 'concrete-finishing' && '🎨'}
            {s.slug === 'core-drilling' && '⭕'}
            {s.slug === 'driveway-replacement' && '🏠'}
            {s.slug === 'foundation-repair' && '🏗️'}
            {s.slug === 'stamped-concrete' && '✨'}
            {s.slug === 'concrete-pool-deck' && '🏊'}
          </span>{s.name}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- States -->
  <section class="ppc-states">
    <div class="container">
      <h3>Serving 5 States:</h3>
      <div class="ppc-states-list">
        <span class="ppc-state-badge">Texas</span>
        <span class="ppc-state-badge">Florida</span>
        <span class="ppc-state-badge">California</span>
        <span class="ppc-state-badge">Arizona</span>
        <span class="ppc-state-badge">Colorado</span>
      </div>
    </div>
  </section>

  <script is:inline>
    // Track CTA clicks for attribution
    document.getElementById('ppcMainCta')?.addEventListener('click', function() {
      try {
        sessionStorage.setItem('ppc_click_time', Date.now().toString());
        sessionStorage.setItem('ppc_source', 'direct');
      } catch(e) {}
    });

    // Callback form: submit via fetch to worker, then redirect to thanks
    document.getElementById('ppcCallbackForm')?.addEventListener('submit', function(e) {
      e.preventDefault();
      var form = this;
      var data = new FormData(form);
      var json = {};
      data.forEach(function(value, key) { json[key] = value; });

      // Store for thank-you page display
      try {
        sessionStorage.setItem('ppc_name', json.name || '');
        sessionStorage.setItem('ppc_phone', json.phone || '');
        sessionStorage.setItem('ppc_zip', json.zip || '');
        sessionStorage.setItem('ppc_service', json.service || '');
        sessionStorage.setItem('ppc_click_time', Date.now().toString());
        sessionStorage.setItem('ppc_source', 'callback_form');
      } catch(e) {}

      // Submit to worker
      fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(json)
      }).then(function() {
        window.location.href = '/call/thanks/';
      }).catch(function() {
        // Still redirect to thanks even if submission fails
        window.location.href = '/call/thanks/';
      });
    });
  </script>
</Base>
