---
// Pay-per-call optimized landing page
// This page is designed for PPCall traffic — clean, fast, phone-first
// No navigation distractions, no forms, just "call now"
import Base from '../layouts/Base.astro';
const phone = "(833) 722-3359";
const phoneHref = "tel:+183****3359";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Licensed Concrete Contractors — Free Estimates | USA Concrete Jobs</title>
  <meta name="description" content="Connect with licensed, insured concrete contractors in your area. Free estimates for concrete cutting, waterproofing, finishing, and more. Call now." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --green: #16a34a;
      --green-dark: #166534;
      --green-light: #22c55e;
      --bg: #0a0f0d;
      --bg-card: #111a15;
      --text: #f0fdf4;
      --text-muted: #86efac;
      --accent: #facc15;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .container { max-width: 680px; margin: 0 auto; padding: 0 20px; text-align: center; }

    /* Hero */
    .hero {
      padding: 48px 0 32px;
      background: linear-gradient(180deg, #0d1f18 0%, var(--bg) 100%);
    }
    .hero-badge {
      display: inline-block;
      background: rgba(22,163,74,0.15);
      color: var(--green-light);
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 20px;
      border: 1px solid rgba(22,163,74,0.3);
    }
    .hero h1 {
      font-size: clamp(2rem, 6vw, 3rem);
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 16px;
    }
    .hero h1 span { color: var(--accent); }
    .hero-subtitle {
      font-size: 1.15rem;
      color: var(--text-muted);
      margin-bottom: 32px;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }

    /* CTA Button */
    .cta-button {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--green);
      color: #fff;
      font-size: 1.4rem;
      font-weight: 800;
      padding: 20px 48px;
      border-radius: 60px;
      text-decoration: none;
      transition: all 0.2s;
      box-shadow: 0 4px 24px rgba(22,163,74,0.4);
      animation: pulse 2s infinite;
    }
    .cta-button:hover {
      background: var(--green-light);
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(22,163,74,0.5);
    }
    @keyframes pulse {
      0%, 100% { box-shadow: 0 4px 24px rgba(22,163,74,0.4); }
      50% { box-shadow: 0 4px 40px rgba(22,163,74,0.6); }
    }
    .cta-phone { font-size: 1.6rem; letter-spacing: 1px; }

    /* Trust */
    .trust {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 24px;
      flex-wrap: wrap;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.9rem;
      color: var(--text-muted);
    }
    .trust-item .check { color: var(--green-light); font-weight: 700; }

    /* Secondary CTA */
    .secondary-cta {
      padding: 32px 0;
    }
    .secondary-cta p {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 12px;
    }
    .secondary-cta a {
      color: var(--green-light);
      font-weight: 700;
      text-decoration: none;
      font-size: 1.1rem;
    }
    .secondary-cta a:hover { text-decoration: underline; }

    /* Services */
    .services {
      padding: 32px 0;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .services-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 20px;
    }
    .service-item {
      background: var(--bg-card);
      padding: 14px 16px;
      border-radius: 10px;
      font-size: 0.9rem;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .service-icon { font-size: 1.3rem; }

    /* States */
    .states {
      padding: 24px 0;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .states-list {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-top: 12px;
      flex-wrap: wrap;
    }
    .state-badge {
      background: var(--bg-card);
      padding: 8px 20px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.95rem;
    }

    /* Footer */
    footer {
      padding: 24px 0;
      margin-top: auto;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    footer p {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.3);
    }

    @media (max-width: 480px) {
      .services-grid { grid-template-columns: 1fr; }
      .trust { gap: 12px; }
      .cta-button { padding: 18px 36px; font-size: 1.2rem; }
    }
  </style>
</head>
<body>

  <section class="hero">
    <div class="container">
      <div class="hero-badge">✓ Licensed & Insured Contractors</div>
      <h1>Need Concrete Work? <span>Call Now for a Free Estimate.</span></h1>
      <p class="hero-subtitle">
        We connect you with top-rated, licensed concrete contractors in your area. No obligation. No hassle. Just quality work at a fair price.
      </p>
      <a href={phoneHref} class="cta-button">
        📞 <span class="cta-phone">{phone}</span>
      </a>
      <div class="trust">
        <div class="trust-item"><span class="check">✓</span> Free Estimates</div>
        <div class="trust-item"><span class="check">✓</span> Licensed & Insured</div>
        <div class="trust-item"><span class="check">✓</span> 500+ Cities</div>
        <div class="trust-item"><span class="check">✓</span> Same-Day Response</div>
      </div>
    </div>
  </section>

  <section class="secondary-cta">
    <div class="container">
      <p>Or call us directly — speak to a contractor in your area now:</p>
      <a href={phoneHref}>{phone}</a>
    </div>
  </section>

  <section class="services">
    <div class="container">
      <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:4px;">Our Contractors Specialize In:</p>
      <div class="services-grid">
        <div class="service-item"><span class="service-icon">🔪</span> Concrete Cutting & Sawing</div>
        <div class="service-item"><span class="service-icon">💧</span> Basement Waterproofing</div>
        <div class="service-item"><span class="service-icon">🎨</span> Concrete Finishing & Repair</div>
        <div class="service-item"><span class="service-icon">⭕</span> Core Drilling</div>
        <div class="service-item"><span class="service-icon">🏠</span> Driveway Replacement</div>
        <div class="service-item"><span class="service-icon">🏗️</span> Foundation Repair</div>
        <div class="service-item"><span class="service-icon">✨</span> Stamped Concrete</div>
        <div class="service-item"><span class="service-icon">🏊</span> Pool Deck Concrete</div>
      </div>
    </div>
  </section>

  <section class="states">
    <div class="container">
      <p style="color:var(--text-muted); font-size:0.9rem;">Serving 5 States:</p>
      <div class="states-list">
        <span class="state-badge">Texas</span>
        <span class="state-badge">Florida</span>
        <span class="state-badge">California</span>
        <span class="state-badge">Arizona</span>
        <span class="state-badge">Colorado</span>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <p>© 2026 USA Concrete Jobs. Connecting homeowners with licensed concrete contractors.</p>
    </div>
  </footer>

</body>
</html>
