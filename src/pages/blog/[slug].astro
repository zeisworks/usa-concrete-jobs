---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { posts } from '../../data/blog.js';
import { readArticles } from '../../lib/articleStore';

const { slug } = Astro.params;
const siteUrl = "https://usaconcretejobs.com";

const dynamic = readArticles().find(a => a.slug === slug && a.status === 'publish');
const post = dynamic ?? posts.find(p => p.slug === slug);

if (!post) {
  return Astro.redirect('/blog/', 302);
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.description,
  "datePublished": post.date,
  "image": post.heroImageUrl ?? `${siteUrl}/og-image.png`,
  "author": {
    "@type": "Organization",
    "name": "USA Concrete Jobs",
    "@id": `${siteUrl}/#organization`
  },
  "publisher": { "@id": `${siteUrl}/#organization` },
  "url": `${siteUrl}/blog/${post.slug}/`,
  "mainEntityOfPage": `${siteUrl}/blog/${post.slug}/`
};
---

<Base
  title={`${post.title} | USA Concrete Jobs`}
  description={post.description}
  canonical={`${siteUrl}/blog/${post.slug}/`}
  schema={articleSchema}
>

  <div class="page-hero">
    <div class="container">
      <div class="article-hero-meta">
        <a href="/blog/" class="back-link">← All Articles</a>
        <span class="blog-category-badge">{post.category}</span>
      </div>
      <h1>{post.title}</h1>
      <div class="article-meta">
        <span>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>·</span>
        <span>{post.readTime}</span>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container article-layout">

      <article class="article-body" set:html={post.content} />

      <aside class="article-sidebar">
        <div class="sidebar-card">
          <h3>Get a Free Estimate</h3>
          <p>Licensed contractors serving TX, FL, CA, AZ, and CO. Call for a free quote.</p>
          <a href="tel:+18337223359" class="btn btn-primary btn-full">(833) 722-3359</a>
          <a href="/contact/" class="btn btn-outline btn-full" style="margin-top:10px;">Contact Us</a>
        </div>

        <div class="sidebar-card" style="margin-top:20px;">
          <h3>More Articles</h3>
          <ul class="sidebar-links">
            {[...readArticles().filter(a => a.status === 'publish' && a.slug !== slug), ...posts.filter(p => p.slug !== slug && !readArticles().some(a => a.slug === p.slug))].slice(0, 4).map(p => (
              <li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>
            ))}
          </ul>
          <a href="/blog/" style="font-size:0.85rem;color:var(--color-accent,#f57c00);font-weight:600;">View all articles →</a>
        </div>
      </aside>

    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Ready to Start Your Project?</h2>
      <p>Get connected with a licensed concrete contractor for a free estimate.</p>
      <a href="tel:+18337223359" class="cta-phone">(833) 722-3359</a>
      <p class="cta-subtext">Available Mon–Sat, 7am–6pm</p>
    </div>
  </section>

</Base>

<style>
  .article-hero-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .back-link {
    color: rgba(255,255,255,0.8);
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 500;
  }
  .back-link:hover { color: #fff; }
  .blog-category-badge {
    background: var(--color-accent, #f57c00);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .article-meta {
    display: flex;
    gap: 8px;
    color: rgba(255,255,255,0.75);
    font-size: 0.9rem;
    margin-top: 8px;
  }
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 768px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .article-sidebar { order: -1; }
  }
  .article-body {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text, #1e293b);
  }
  .article-body h2 {
    font-size: 1.4rem;
    color: var(--color-primary, #1e3a5f);
    margin: 36px 0 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-accent, #f57c00);
  }
  .article-body h3 {
    font-size: 1.1rem;
    color: var(--color-primary, #1e3a5f);
    margin: 24px 0 10px;
  }
  .article-body p { margin-bottom: 16px; }
  .article-body ul,
  .article-body ol {
    margin: 0 0 16px 20px;
  }
  .article-body li { margin-bottom: 6px; }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0 24px;
    font-size: 0.9rem;
  }
  .article-body th {
    background: var(--color-primary, #1e3a5f);
    color: #fff;
    padding: 10px 14px;
    text-align: left;
  }
  .article-body td {
    padding: 9px 14px;
    border-bottom: 1px solid #e2e8f0;
  }
  .article-body tr:nth-child(even) td { background: #f8fafc; }
  .sidebar-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 22px;
  }
  .sidebar-card h3 {
    font-size: 1rem;
    color: var(--color-primary, #1e3a5f);
    margin-bottom: 10px;
  }
  .sidebar-card p {
    font-size: 0.875rem;
    color: var(--color-text-muted, #64748b);
    margin-bottom: 14px;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
  }
  .sidebar-links li { margin-bottom: 10px; }
  .sidebar-links a {
    font-size: 0.875rem;
    color: var(--color-primary, #1e3a5f);
    text-decoration: none;
    line-height: 1.4;
  }
  .sidebar-links a:hover { color: var(--color-accent, #f57c00); }
  .btn-full { width: 100%; text-align: center; display: block; }
</style>
