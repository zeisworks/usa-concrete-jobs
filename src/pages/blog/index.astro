---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/blog.js';

const siteUrl = "https://usaconcretejobs.com";

const sorted = [...posts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "USA Concrete Jobs — Articles & Guides",
  "url": `${siteUrl}/blog/`,
  "description": "Expert articles on concrete cutting, waterproofing, permits, costs, and hiring tips for homeowners and contractors.",
  "publisher": { "@id": `${siteUrl}/#organization` }
};
---

<Base
  title="Concrete Cutting Articles & Guides | USA Concrete Jobs"
  description="Expert guides on concrete cutting costs, methods, permits, waterproofing, and how to hire licensed contractors in Texas, Florida, California, Arizona, and Colorado."
  canonical={`${siteUrl}/blog/`}
  schema={blogSchema}
>

  <div class="page-hero">
    <div class="container">
      <h1>Concrete Cutting Articles & Guides</h1>
      <p>Expert advice on costs, methods, permits, and hiring licensed contractors.</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:900px;">

      <div class="blog-categories" style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:36px;">
        {[...new Set(sorted.map(p => p.category))].map(cat => (
          <span class="blog-category-badge">{cat}</span>
        ))}
      </div>

      <div class="blog-list">
        {sorted.map(post => (
          <article class="blog-card">
            <div class="blog-card-meta">
              <span class="blog-category-badge">{post.category}</span>
              <span class="blog-date">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <span class="blog-read-time">{post.readTime}</span>
            </div>
            <h2 class="blog-card-title">
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h2>
            <p class="blog-card-excerpt">{post.excerpt}</p>
            <a href={`/blog/${post.slug}/`} class="btn btn-outline btn-sm">Read Article →</a>
          </article>
        ))}
      </div>

    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Have a Concrete Project?</h2>
      <p>Get connected with a licensed contractor for a free estimate.</p>
      <a href="tel:+18337223359" class="cta-phone">(833) 722-3359</a>
      <p class="cta-subtext">Available Mon–Sat, 7am–6pm</p>
    </div>
  </section>

</Base>

<style>
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .blog-card {
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 12px;
    padding: 28px 32px;
    background: #fff;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .blog-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    transform: translateY(-2px);
  }
  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .blog-category-badge {
    background: var(--color-accent, #f57c00);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .blog-date,
  .blog-read-time {
    font-size: 0.85rem;
    color: var(--color-text-muted, #64748b);
  }
  .blog-card-title {
    font-size: 1.25rem;
    margin: 0 0 12px;
    line-height: 1.4;
  }
  .blog-card-title a {
    color: var(--color-primary, #1e3a5f);
    text-decoration: none;
  }
  .blog-card-title a:hover {
    color: var(--color-accent, #f57c00);
  }
  .blog-card-excerpt {
    color: var(--color-text-muted, #64748b);
    font-size: 0.95rem;
    margin-bottom: 16px;
    line-height: 1.6;
  }
</style>
